# Copy to docker/.env (git-ignored) and adjust. Never commit real secrets.
IMAGE_NAME=nexvion-store
IMAGE_TAG=latest
APP_PORT=8082
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
KIBANA_PORT=5601
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Docker data root (docker info --format '{{.DockerRootDir}}'); snap installs use /var/snap/docker/common/var-lib-docker
DOCKER_ROOT=/var/lib/docker

# Dependencies & build output
node_modules/
application/dist/
*.tgz
test-results/

# Secrets & local environment - never commit
docker/.env
*.pem
*.key
ansible/kubeconfig-*.yaml

# Generated by Terraform (contains real IPs) - example kept
ansible/inventory/*.ini
!ansible/inventory/hosts.ini.example

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Runtime output
backups/
logs/
incident/
security/reports/

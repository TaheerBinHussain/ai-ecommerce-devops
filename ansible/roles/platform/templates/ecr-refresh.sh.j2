#!/usr/bin/env bash
# Managed by Ansible: refreshes the "ecr-pull" image pull secret in the {{ app_namespace }} namespace.
set -euo pipefail
password="$(/snap/bin/aws ecr get-login-password --region {{ aws_region }})"
/usr/local/bin/k3s kubectl -n {{ app_namespace }} create secret docker-registry ecr-pull \
  --docker-server={{ ecr_registry }} --docker-username=AWS --docker-password="$password" \
  --dry-run=client -o yaml | /usr/local/bin/k3s kubectl apply -f -
echo "$(date -Is) ecr-pull secret refreshed"
